import java.util.Scanner;

public class Practice_4 {

    
    public static void printTable(int n) {
        System.out.println("\n--- Multiplication Table for " + n + " ---");
        for (int i = 1; i <= 10; i++) {
            System.out.println(n + " * " + i + " = " + (n * i));
        }
    }

    
    public boolean isPrime(int n) {
        if (n <= 1) {
            return false;
        }
        for (int i = 2; i <= Math.sqrt(n); i++) {
            if (n % i == 0) {
                return false;
            }
        }
        return true; 
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        Practice_4 menuObj = new Practice_4(); 
        int choice;

        do {
            System.out.println("\n--- MATH MENU ---");
            System.out.println("1. Print Multiplication Table (Static Method)");
            System.out.println("2. Check Prime Number (Non-Static Method)");
            System.out.println("3. Exit");
            System.out.print("Enter your choice (1-3): ");
            
            choice = scanner.nextInt();

            switch (choice) {
                case 1:
                    System.out.print("Enter a number for the table: ");
                    int tableNum = scanner.nextInt();
                    printTable(tableNum); 
                    break;

                case 2:
                    System.out.print("Enter a number to check prime: ");
                    int primeNum = scanner.nextInt();
                   
                    if (menuObj.isPrime(primeNum)) {
                        System.out.println(primeNum + " is a prime number.");
                    } else {
                        System.out.println(primeNum + " is not a prime number.");
                    }
                    break;

                case 3:
                    System.out.println("Exiting program. Goodbye!");
                    break;

                default:
                    System.out.println("Invalid choice! Please choose between 1 and 3.");
            }
        } while (choice != 3);

        scanner.close();
    }
}
