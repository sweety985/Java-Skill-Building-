import java.util.Scanner;

public class Practice_4 {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        
        System.out.print("Enter first side (a): ");
        int a = scanner.nextInt();
        
        System.out.print("Enter second side (b): ");
        int b = scanner.nextInt();
        
        System.out.print("Enter third side (c): ");
        int c = scanner.nextInt();
        
        if ((a + b > c) && (a + c > b) && (b + c > a)) {
            System.out.println("The given sides can form a valid triangle.");
        } else {
            System.out.println("The given sides cannot form a valid triangle.");
        }
        
        scanner.close();
    }
}
