public class Practice_5 {

    
    public static void printTable(int n) {
        System.out.println("--- Multiplication Table for " + n + " ---");
        
        for (int i = 1; i <= 10; i++) {
            System.out.println(n + " * " + i + " = " + (n * i));
        }
    }

    public static void main(String[] args) {
        int number = 7; 
        
        
        printTable(number);
    }
}
